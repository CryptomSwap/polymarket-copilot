# Database (required for Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/polymarket_copilot?schema=public"

# Optional: Polymarket API
# POLYMARKET_HOST="https://polymarket.com"
# POLYMARKET_CHAIN_ID=137

# Credential init uses MetaMask L1 signing (no server key required).
# Optional: for server-side order place/cancel (funder wallet key; must match API credentials)
# POLYMARKET_SIGNER_PRIVATE_KEY=0x...

# Required for init-credentials: AES-256 key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CREDENTIAL_ENCRYPTION_KEY=<paste base64 output; 44 chars, or 64 hex, or 32+ char passphrase>
