# Database (required for Prisma)
#
# When running on the host (e.g. `npm run worker` outside Docker),
# use DATABASE_URL pointing at your Postgres (typically `localhost`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/polymarket_copilot?schema=public"

# When running inside Docker Compose containers, use DATABASE_URL_DOCKER
# so that the hostname resolves from the container to your host's existing Postgres.
#
# On Windows, `host.docker.internal` is typically available from Docker Desktop.
DATABASE_URL_DOCKER="postgresql://postgres:postgres@host.docker.internal:5432/polymarket_copilot?schema=public"

# Optional: Polymarket API
# POLYMARKET_HOST="https://polymarket.com"
# POLYMARKET_CHAIN_ID=137

# Credential init uses MetaMask L1 signing (no server key required).
# Optional: for server-side order place/cancel (funder wallet key; must match API credentials)
# POLYMARKET_SIGNER_PRIVATE_KEY=0x...

# Required for init-credentials: AES-256 key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CREDENTIAL_ENCRYPTION_KEY=<paste base64 output; 44 chars, or 64 hex, or 32+ char passphrase>

# Paper trading (shadow ML; no real orders)
# Defaults if unset: PAPER_TRADING_MAX_OPEN_TOTAL=45, PAPER_TRADING_MAX_DAILY_NEW_TRADES=20 (see lib/paper-trading/config.ts).
# Per-bot ceilings: lib/paper-trading/bot-profiles.ts (maxOpenTotal / maxDailyNewTrades per bot).
# PAPER_TRADING_ENABLED=1
# PAPER_TRADING_THRESHOLD=0.3
# PAPER_TRADING_COOLDOWN_HOURS=12
# PAPER_TRADING_COOLDOWN_MARKET_HOURS=0
# PAPER_TRADING_MIN_SCORE_BUFFER=0
# Paper-only admission floor [0,1] (max with per-bot base); wins over PAPER_MIN_SCORE_OVERRIDE_GLOBAL if both set
# PAPER_TRADING_MIN_SCORE_OVERRIDE=0.75
# PAPER_TRADING_MAX_OPEN_TOTAL=45
# PAPER_TRADING_MAX_OPEN_PER_MARKET=0
# PAPER_TRADING_MAX_OPEN_PER_THEME=0
# PAPER_TRADING_MAX_OPEN_PER_CATEGORY=0
# PAPER_TRADING_MAX_DAILY_NEW_TRADES=20
# PAPER_TRADING_ALLOW_REVIEW_REQUIRED=0
# PAPER_TRADING_ALLOW_BLOCK_EDGE_TOO_SMALL=1
# PAPER_TRADING_ALLOW_BLOCK_LOW_LIQUIDITY=1
# PAPER_TRADING_ALLOW_BLOCK_CROWDED=0
# PAPER_TRADING_RELAXED_CONCENTRATION_STAKE_NOTIONAL=2
# PAPER_TRADING_RELAXED_CONCENTRATION_MAX_PER_TICK=3
# PAPER_TRADING_RELAXED_CONCENTRATION_MAX_PER_DAY=25
# PAPER_TRADING_RELAXED_CONCENTRATION_MAX_OPEN_PER_MARKET=1
# PAPER_TRADING_RELAXED_CONCENTRATION_MAX_OPEN_PER_THEME=8

# Self-improvement loop (paper + shadow only; runtime safety/live guardrails remain fixed/manual)
# SELF_IMPROVE_TARGET_LABEL=labelGoodDecision12h
# SELF_IMPROVE_DATASET_BUILD_LIMIT=1500
# SELF_IMPROVE_TRAIN_LIMIT=5000
# SELF_IMPROVE_TRAIN_RATIO=0.8
# SELF_IMPROVE_MIN_EVAL_SAMPLES=250
# SELF_IMPROVE_HOLDOUT_DAYS=14
# SELF_IMPROVE_HOLDOUT_MAX_ROWS=10000
# SELF_IMPROVE_MIN_AUC_DELTA=0.01
# SELF_IMPROVE_MIN_F1_DELTA=0.01
# SELF_IMPROVE_MIN_POSITIVE_RATE=0.05
# SELF_IMPROVE_MIN_NEGATIVE_RATE=0.05
# SELF_IMPROVE_BASELINE_LOOKBACK_DAYS=7
# SELF_IMPROVE_ROLLBACK_MIN_SAMPLES=30
# SELF_IMPROVE_ROLLBACK_MEAN_PNL_DELTA=-0.015
# SELF_IMPROVE_ROLLBACK_LOOKBACK_DAYS=5

# Paper config optimizer (paper-only bounded knobs)
# PAPER_CONFIG_OPTIMIZER_LOOKBACK_DAYS=14
# PAPER_CONFIG_OPTIMIZER_MIN_SAMPLES=40
# PAPER_CONFIG_OPTIMIZER_THRESHOLD_STEP=0.01
# PAPER_CONFIG_OPTIMIZER_COOLDOWN_STEP_HOURS=1
# PAPER_CONFIG_OPTIMIZER_DAILY_TRADES_STEP=3
# PAPER_CONFIG_OPTIMIZER_AUTO_APPLY=0
# PAPER_CONFIG_OPTIMIZER_BASELINE_LOOKBACK_DAYS=7

# Runtime in-memory bounds (safe memory pressure control; no trading logic change)
# RUNTIME_ORDER_TERMINAL_TTL_MS=21600000
# RUNTIME_ORDER_TERMINAL_MAX=4000
# RUNTIME_MARKET_STATE_MAX_ASSETS=5000
# RUNTIME_MARKET_STATE_INACTIVE_EVICT_MS=21600000
# RUNTIME_POSITION_STORE_MAX_POSITIONS=5000
# RUNTIME_POSITION_ZERO_TTL_MS=21600000
# SHADOW_DATASET_BUILD_PAGE_SIZE=200
# SHADOW_DATASET_PERSIST_BATCH_SIZE=200

# Worker logging (affects worker + runtime diagnostics emitted to stdout)
# LOG_LEVEL="debug" | "info" | "warn" | "error" (default: "info")
LOG_LEVEL="info"
